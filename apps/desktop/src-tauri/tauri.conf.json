{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Candeo",
  "version": "0.2.0",
  "identifier": "com.o2csi.candeo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Candeo",
        "create": false,
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "O2CSI",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "upgradeCode": "063517D8-1EE6-5EB0-877C-D8C0DA6C6EDD"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/60-candeo.rules": "../../../packaging/linux/60-candeo.rules"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/60-candeo.rules": "../../../packaging/linux/60-candeo.rules"
        }
      }
    }
  }
}
